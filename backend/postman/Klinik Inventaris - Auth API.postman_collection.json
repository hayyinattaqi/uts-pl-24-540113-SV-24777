{
  "info": {
    "_postman_id": "ee017799-3335-4541-8297-7c3626811bbb",
    "name": "Klinik Inventaris - Auth API",
    "description": "Koleksi pengujian endpoint autentikasi yang sudah tersedia: login dan logout Sanctum. Isi variabel admin_email dan admin_password dengan kredensial lokal sebelum menjalankan request Login - sukses.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "50523494"
  },
  "item": [
    {
      "name": "00 Auth - Login",
      "item": [
        {
          "name": "Login - password salah",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Password salah menghasilkan status 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Respons berisi pesan error', function () {",
                  "    pm.expect(pm.response.json()).to.have.property('message');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{invalid_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Isi invalid_password dengan password yang tidak cocok dengan akun admin. Request ini mengharapkan 401."
          },
          "response": []
        },
        {
          "name": "Login - email kosong",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Email kosong menghasilkan status 422', function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "",
                  "pm.test('Respons menunjukkan error validasi email', function () {",
                  "    pm.expect(pm.response.json().errors).to.have.property('email');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Mengirim email kosong untuk memeriksa validasi 422."
          },
          "response": []
        },
        {
          "name": "Login - sukses",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login berhasil dengan status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "pm.test('Respons berisi token dan data user', function () {",
                  "    pm.expect(response).to.have.property('data');",
                  "    pm.expect(response.data).to.have.property('token').that.is.a('string').and.not.empty;",
                  "    pm.expect(response.data).to.have.property('user');",
                  "    pm.expect(response).to.have.property('message');",
                  "});",
                  "",
                  "if (response.data && response.data.token) {",
                  "    pm.collectionVariables.set('token', response.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Login menggunakan admin yang sudah disiapkan melalui ADMIN_EMAIL dan ADMIN_PASSWORD. Token dari respons disimpan otomatis ke variabel koleksi token."
          },
          "response": []
        }
      ]
    },
    {
