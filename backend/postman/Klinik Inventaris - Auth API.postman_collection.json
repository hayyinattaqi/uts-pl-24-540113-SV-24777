                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 401\", () => pm.response.to.have.status(401));\r",
                  "const body = pm.response.json();\r",
                  "pm.test(\"Ada id\", () => pm.expect(body).to.have.property('data').that.is.an('object').that.has.property('id').that.is.a(\"number\"));\r",
                  "pm.collectionVariables.set(\"medicine_id\", body.data.id);\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
