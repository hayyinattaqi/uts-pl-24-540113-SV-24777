              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 422', () => pm.response.to.have.status(422));",
                  "const errors = pm.response.json().errors;",
                  "pm.test('Ada errors.code', () => pm.expect(errors).to.have.property('code'));",
                  "pm.test('Ada errors.name', () => pm.expect(errors).to.have.property('name'));",
                  "pm.test('Ada errors.unit', () => pm.expect(errors).to.have.property('unit'));"
